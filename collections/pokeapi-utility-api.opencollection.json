{
  "opencollection": "1.0.0",
  "info": {
    "name": "Poké Berries Utility API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "Utility",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Languages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pokeapi.co/api/v2/language",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip before starting to collect the result set."
              }
            ]
          },
          "docs": "List all supported languages."
        },
        {
          "info": {
            "name": "Get Language",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pokeapi.co/api/v2/language/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource id (integer) or name (slug)."
              }
            ]
          },
          "docs": "Retrieve a single language by id or name."
        }
      ]
    }
  ],
  "bundled": true
}