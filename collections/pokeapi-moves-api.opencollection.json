      "info": {
        "name": "Moves",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Moves",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pokeapi.co/api/v2/move",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip before starting to collect the result set."
              }
            ]
          },
          "docs": "List all moves."
        },
        {
          "info": {
            "name": "Get Move",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pokeapi.co/api/v2/move/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource id (integer) or name (slug)."
              }
            ]
          },
          "docs": "Retrieve a single move by id or name."
