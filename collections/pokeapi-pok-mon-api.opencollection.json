          "info": {
            "name": "List Abilities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pokeapi.co/api/v2/ability",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip before starting to collect the result set."
              }
            ]
          },
          "docs": "List all Pokémon abilities."
        },
        {
          "info": {
            "name": "Get Ability",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pokeapi.co/api/v2/ability/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource id (integer) or name (slug)."
              }
